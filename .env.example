# Copy this file to .env and fill in secrets before running the app.

# Backend
SERVER_PORT=8200

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=interview_guide
POSTGRES_USER=postgres
POSTGRES_PASSWORD=password

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# RabbitMQ
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# RustFS / S3-compatible storage
RUSTFS_ACCESS_KEY=rustfsadmin
RUSTFS_SECRET_KEY=rustfsadmin
APP_STORAGE_ENDPOINT=http://localhost:9000
APP_STORAGE_ACCESS_KEY=rustfsadmin
APP_STORAGE_SECRET_KEY=rustfsadmin
APP_STORAGE_BUCKET=interview-guide
APP_STORAGE_REGION=us-east-1

# Auth
APP_AUTH_TOKEN_SECRET=replace-with-a-random-secret-at-least-32-chars
APP_AUTH_ADMIN_INITIALIZE_ON_STARTUP=false
APP_AUTH_ADMIN_USERNAME=admin
APP_AUTH_ADMIN_PASSWORD=replace-with-a-strong-password
APP_AUTH_ADMIN_DISPLAY_NAME=System Admin

# OpenAI-compatible model provider
APP_AI_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
APP_AI_MODEL_API_KEY=
APP_AI_MODEL_CHAT_MODEL=qwen-turbo
APP_AI_MODEL_EMBEDDING_MODEL=text-embedding-v4
APP_AI_MODEL_EMBEDDING_DIMENSIONS=1024

# Optional ASR/TTS overrides. Leave empty to configure in the Settings page.
APP_VOICE_ASR_API_KEY=
APP_VOICE_TTS_API_KEY=

# Frontend Docker proxy target. Local Vite dev uses VITE_API_PROXY_TARGET instead.
FRONTEND_API_BACKEND=host.docker.internal:8200
